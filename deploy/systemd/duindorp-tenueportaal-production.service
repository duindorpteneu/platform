[Unit]
Description=Duindorp SV Tenueportaal production
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=duindorp-production
Group=duindorp-production
WorkingDirectory=/srv/duindorp-tenueportaal/production/current
EnvironmentFile=/srv/duindorp-tenueportaal/production/shared/app.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/duindorp-tenueportaal/production

[Install]
WantedBy=multi-user.target
