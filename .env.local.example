# Local app
APP_BASE_URL=http://localhost:3100

# Local Supabase API runs on 54329. Copy the local publishable and secret keys
# from `pnpm exec supabase status` into an untracked `.env.local`; never commit them.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54329
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54339/postgres
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Server-only secrets; use unique random values per environment.
PARENT_TOKEN_PEPPER=
# Canonieke 32-byte base64url-sleutel (43 tekens) en een oplopende versie.
QR_TOKEN_PEPPER=
QR_TOKEN_PEPPER_VERSION=1
# Alleen samen invullen tijdens een gecontroleerde sleutelrotatie.
QR_TOKEN_PREVIOUS_PEPPER=
QR_TOKEN_PREVIOUS_PEPPER_VERSION=
CRON_SECRET=
OPERATIONS_HEARTBEAT_URL=
DYNAMIC_IMPORT_ENABLED=false
IMPORT_STAGING_ENCRYPTION_KEY=
IMPORT_RAW_RETENTION_HOURS=24

# External providers stay disabled for local MVP development by default.
MOLLIE_ENABLED=false
MOLLIE_API_KEY=
MOLLIE_PROFILE_ID=
EMAIL_ENABLED=false
SENDGRID_API_KEY=
SENDGRID_API_KEY_FINGERPRINT=
SENDGRID_API_BASE_URL=https://api.sendgrid.com
SENDGRID_FROM_NAME=Kledingcommissie Duindorp SV
SENDGRID_FROM_EMAIL=kleding@duindorpsv.nl
SENDGRID_REPLY_TO_EMAIL=kleding@duindorpsv.nl
SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY=
SENDGRID_WEBHOOK_ID=

# Staging/provider/release acceptance only; never loaded by the browser.
SENDGRID_ADMIN_API_KEY=
SENDGRID_EXPECTED_ACCOUNT_FINGERPRINT=
SENDGRID_SMOKE_RECIPIENT=
STAGING_CLEANUP_BACKUP_PASSPHRASE=
PRODUCTION_BACKUP_PASSPHRASE=

# Door de immutable releaseketen uit het geverifieerde manifest gezet.
RELEASE_ARTIFACT_DIGEST=
